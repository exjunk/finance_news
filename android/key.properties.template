# Android Signing – key.properties
# ⚠️  This file is gitignored. NEVER commit it.
# Copy this template, fill in the values, and save as android/key.properties
#
# To generate a new keystore:
#   keytool -genkey -v -keystore stockswipe-release.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 \
#     -alias stockswipe -storepass YOUR_STORE_PASS -keypass YOUR_KEY_PASS
#
# Then base64-encode it for the GitHub Secret KEYSTORE_BASE64:
#   base64 -i stockswipe-release.jks | pbcopy   (macOS)

storeFile=../stockswipe-release.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=stockswipe
keyPassword=YOUR_KEY_PASSWORD
